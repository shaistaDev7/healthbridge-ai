# Copy this file to .streamlit/secrets.toml for local use, or paste the
# contents into: Streamlit Community Cloud -> your app -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

XAI_API_KEY = "xai-your-key-here"
XAI_MODEL   = "grok-4.7"
SECRET_KEY  = "change-me-to-a-long-random-string"

# Optional: use a separately deployed FastAPI backend (e.g. on Render).
# Leave this out and the backend runs inside the Streamlit app automatically.
# API_URL = "https://your-backend.onrender.com"
