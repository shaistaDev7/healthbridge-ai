# Copy to ".env" and fill in. The .env file is private and ignored by git.

# --- Grok (xAI) ---------------------------------------------------------
# Get a key at https://console.x.ai  (without a key the app still works,
# using rule-based fallbacks instead of AI)
XAI_API_KEY=
XAI_MODEL=llama-3.3-70b-versatile
XAI_BASE_URL=https://api.groq.com/openai/v1
AI_ENABLED=true

# --- Security -------------------------------------------------------------
# Long random string used to sign login tokens.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-please-32chars-min

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./healthbridge.db
# DATABASE_URL=postgresql://user:password@host:5432/healthbridge

# --- Behaviour ------------------------------------------------------------
AUTO_SEED=true
BREAK_GLASS_HOURS=2

# Only if the backend runs separately from Streamlit:
# API_URL=http://localhost:8000